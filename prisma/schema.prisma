// Fieldnote — production data model.
// NOTE: This sandbox can't reach binaries.prisma.sh to download Prisma's
// query engine, so the running app in this build uses an in-memory data
// layer (src/lib/data.ts) shaped identically to these models. Once you
// clone the repo somewhere with normal network access:
//   1. Set DATABASE_URL in .env (Postgres recommended)
//   2. npx prisma generate
//   3. npx prisma migrate dev --name init
//   4. Swap the imports in src/lib/data.ts for real @prisma/client calls
//      (the function signatures are already shaped to match 1:1)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  passwordHash  String?
  phone         String?   @unique
  name          String
  role          Role      @default(CUSTOMER)
  blocked       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  loginCount    Int       @default(0)

  addresses     Address[]
  orders        Order[]
  cartItems     CartItem[]
  wishlist      Wishlist[]
  reviews       Review[]
  notifications Notification[]
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  parentId        String?
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  products        Product[]
  metaTitle       String?
  metaDescription String?
}

model Product {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String
  price         Int             // cents
  comparePrice  Int?            // cents, optional strike-through price
  stock         Int             @default(0)
  featured      Boolean         @default(false)
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  createdAt     DateTime        @default(now())
  metaTitle     String?
  metaDescription String?
  // Denormalized aggregate, recalculated whenever a review's approval
  // status changes (see setReviewApproved / deleteReview) — avoids an
  // aggregate query on every product list fetch.
  rating        Float           @default(0)
  reviewCount   Int             @default(0)

  images        ProductImage[]
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlist      Wishlist[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  altText   String
  isMain    Boolean @default(false)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  label     String  // e.g. "Size: M / Color: Moss"
  stock     Int     @default(0)
  priceDiff Int     @default(0) // cents, added to base price
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variant   String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  fullName   String
  street     String
  city       String
  state      String
  zip        String
  country    String
  isDefault  Boolean  @default(false)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            OrderStatus @default(PENDING)
  subtotal          Int
  discount          Int         @default(0)
  couponCode        String?
  tax               Int
  shipping          Int
  total             Int
  shippingAddressId String
  shippingAddress   Address     @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  trackingNumber    String?
  adminNotes        String?
  createdAt         DateTime    @default(now())

  items             OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String  // snapshot at time of purchase — survives renames/deletion
  variant     String?
  quantity    Int
  price       Int // cents, price at time of purchase
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  userName  String   // snapshot at time of review — survives renames/deletion
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  coverImage      String?
  published       Boolean  @default(false)
  authorName      String
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  published       Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Single row (id = "default") holding store-wide configuration.
model StoreSettings {
  id                     String  @id @default("default")
  storeName              String  @default("Fieldnote")
  supportEmail           String  @default("support@fieldnote.co")
  currency               String  @default("INR")
  addressLine            String  @default("142, MG Road, Bengaluru, KA 560001")
  freeShippingThreshold  Int     @default(50000) // ₹500 in paise
  flatShippingRate       Int     @default(7000) // ₹70
  expressShippingRate    Int     @default(18000) // ₹180
  defaultTaxPercent      Float   @default(18) // GST default
  metaTitle              String  @default("Fieldnote — Gear for the field")
  metaDescription        String  @default("")
  socialInstagram        String?
  socialTwitter          String?
  maintenanceMode        Boolean @default(false)
}

model TaxRate {
  id          String  @id @default(cuid())
  label       String
  country     String
  region      String? // state/province; blank = applies to whole country
  ratePercent Float
  active      Boolean @default(true)
}

model PasswordResetToken {
  token     String   @id
  userId    String
  expiresAt DateTime
}

model OtpCode {
  phone     String   @id
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "order_status" | "order_tracking" | "welcome" | "review" | "system"
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String   // "percent" | "fixed"
  value        Int      // percent: 0-100, fixed: cents
  minSubtotal  Int?
  maxUses      Int?
  usedCount    Int      @default(0)
  active       Boolean  @default(true)
  expiresAt    DateTime?
}
