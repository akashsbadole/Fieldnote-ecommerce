# Auth.js / NextAuth v5 — required
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Used to build links in emails (password reset, etc). Set to your real
# deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------
# Not required for this build (it runs on an in-memory data layer, see
# README). Set this once you've run `npx prisma generate` /
# `npx prisma migrate dev` with real network access.
# DATABASE_URL="postgresql://user:password@localhost:5432/fieldnote"

# --- Stripe -------------------------------------------------------------
# Optional. Without these, checkout falls back to a demo payment step
# (no real charge). With these, checkout uses real Stripe Elements and
# orders are only created after the server verifies payment succeeded.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or your dashboard

# --- Email (Resend) -------------------------------------------------------
# Optional. Without this, emails (order confirmation, status updates,
# welcome, password reset) are logged to the server console instead of sent.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=orders@yourdomain.com

# Mobile OTP login — without these, codes are logged to the console and
# also returned directly to the login UI for testing.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# --- Google OAuth ---------------------------------------------------------
# Optional. Both must be set for the provider to register, and the second
# public flag must also be set (build-time) for the "Continue with Google"
# button to render on the login page.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
